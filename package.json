{
  "name": "priority-hub",
  "version": "1.0.0",
  "description": "Hub de descargas para Linux y Windows: pega cualquier enlace, detecta el descargable, elige dónde guardarlo y se mantiene actualizado.",
  "main": "main.js",
  "author": "rike",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "test": "node test/logic.test.js && node test/mock.test.js",
    "postinstall": "node scripts/setup-assets.js",
    "predist": "node scripts/setup-assets.js",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@phosphor-icons/web": "2.1.2"
  },
  "build": {
    "appId": "com.rike.priorityhub",
    "productName": "Priority Hub",
    "executableName": "priority-hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Hub de AppImages, scripts y paquetes para Linux"
    },
    "appImage": {
      "artifactName": "Priority-Hub-${version}-x86_64.AppImage"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Priority-Hub-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Priority-Hub-${version}-portable.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vancored/priority-hub.git"
  }
}
